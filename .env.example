# 로컬 포트 설정. setup 실행 시 .env 가 없으면 이 파일을 복사한다.
# 다른 프로젝트와 포트가 겹치면 .env 에서 값만 바꾸고 setup 을 다시 실행.
WEB_PORT=8088
PMA_PORT=8089
DB_PORT_HOST=3310

# 로컬 관리자 회원가입 승인 코드
ADMIN_SIGNUP_CODE=fuselab-dev

# 카페24 FTP 업로드 정보 (임시 가림막 업로드용). 실제 값은 .env 에만 입력
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=/
